SECRET_KEY=replace-with-a-long-random-secret

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=sender@example.com
EMAIL_FOOTER_PHONE=+1-555-0100
EMAIL_FOOTER_WEBSITE=https://desflyer.com

# Public URL used in campaign unsubscribe links; set to the deployed HTTPS origin.
CAMPAIGN_UNSUBSCRIBE_BASE_URL=https://your-domain.example

# The worker processes queued recipients one at a time. The delay is between
# completed sends; temporary retries use exponential backoff in addition.
EMAIL_BATCH_SIZE=1
EMAIL_SEND_DELAY=30
EMAIL_MAX_RETRIES=2
# Legacy names are still accepted by config.py when EMAIL_* values are absent.
CAMPAIGN_POLL_SECONDS=2
MAX_UPLOAD_BYTES=5242880
MAX_ATTACHMENT_BYTES=18874368
MAX_REQUEST_BYTES=26214400

# Desktop app data is stored under %LOCALAPPDATA%/DesFlyer when packaged.
# For a public unsubscribe link, this must be an HTTPS URL reachable by recipients.
# Do not use localhost for real campaigns.
# CAMPAIGN_UNSUBSCRIBE_BASE_URL=https://your-public-domain.example
